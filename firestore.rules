rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Feedback: authenticated users can create
    match /feedbacks/{docId} {
      allow create: if request.auth != null && request.auth.uid != null;
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
    }

    // User data: owner only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /pr13_progress/{title} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
